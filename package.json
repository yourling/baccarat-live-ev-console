{
  "name": "baccarat-ev-console",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/desktop",
    "apps/lord-god-space"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "dev:web": "npm run dev -w @baccarat/desktop",
    "dev:desktop": "npm run dev -w @baccarat/desktop",
    "electron": "npm run electron -w @baccarat/desktop",
    "demo": "tsx scripts/demo.ts",
    "bridge:observe": "tsx scripts/bridge-observe.ts",
    "bridge:reload-extension": "tsx scripts/bridge-command.ts reloadExtension",
    "smoke": "tsx scripts/smoke-console.ts",
    "dev:god": "npm run dev -w @lord-space/game",
    "build:god": "npm run build -w @lord-space/game",
    "typecheck:god": "npm run typecheck -w @lord-space/game",
    "package:desktop:win": "npm run package:win -w @baccarat/desktop",
    "package:desktop:win:installer": "npm run package:win:installer -w @baccarat/desktop"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
