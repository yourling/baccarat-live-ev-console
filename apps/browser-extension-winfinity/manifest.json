{
  "manifest_version": 3,
  "name": "Baccarat Winfinity Room Bridge",
  "version": "0.1.0",
  "key": "",
  "description": "把 Dafabet 桃园厅 Winfinity 多桌数据桥接到本机 EV 中控台。第一期只采集，不下注。",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://*.dafabet.net/*",
    "https://*.youngpoisson.xyz/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.dafabet.net/*",
        "https://*.youngpoisson.xyz/*"
      ],
      "js": [
        "winfinity-protocol.js",
        "winfinity-network-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.dafabet.net/*",
        "https://*.youngpoisson.xyz/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.dafabet.net/*",
        "https://*.youngpoisson.xyz/*"
      ],
      "js": [
        "winfinity-dom-hook.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "点击重载 Winfinity 桥接扩展"
  },
  "commands": {
    "reload-extension": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "重新加载 Winfinity 桥接扩展（不刷新游戏弹窗）"
    }
  }
}
