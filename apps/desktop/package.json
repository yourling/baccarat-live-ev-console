{
  "name": "@baccarat/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "npm run build:web && npm run build:electron && electron .",
    "build:web": "vite build",
    "start": "vite --host 127.0.0.1",
    "build:electron": "node scripts/build-electron.mjs",
    "build:desktop": "npm run build:web && npm run build:electron",
    "package:win": "npm run build:desktop && electron-builder --win portable --x64",
    "package:win:installer": "npm run build:desktop && electron-builder --win nsis --x64",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@baccarat/adapter-contract": "0.1.0",
    "@baccarat/browser-bridge": "0.1.0",
    "@baccarat/contracts": "0.1.0",
    "@baccarat/ledger-state": "0.1.0",
    "@baccarat/orchestrator": "0.1.0",
    "@baccarat/probability": "0.1.0",
    "@baccarat/risk-execution": "0.1.0",
    "@baccarat/room-monitor": "0.1.0",
    "@baccarat/simulator-fixtures": "0.1.0",
    "better-sqlite3": "^13.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "react-doctor": "^0.9.12",
    "react-grab": "^0.1.37",
    "react-scan": "^0.5.7",
    "vite": "^5.4.0"
  },
  "main": "electron-dist/main.cjs",
  "build": {
    "appId": "com.baccarat.evconsole",
    "productName": "百家乐实时 EV 中控台",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../browser-extension",
        "to": "browser-extension",
        "filter": [
          "**/*",
          "!README.md"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "electronVersion": "43.4.0"
  }
}
