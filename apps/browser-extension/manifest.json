{
  "manifest_version": 3,
  "name": "Baccarat Real Room Bridge",
  "version": "0.1.0",
  "description": "把真实游戏房间/牌桌数据从浏览器桥接到本机 EV 中控台，并预留真实下注执行通道。",
  "permissions": [
    "storage",
    "tabs",
    "debugger",
    "scripting"
  ],
  "host_permissions": [
    "https://*.dafabet.net/*",
    "https://*.dafabet.com/*",
    "https://*.df888evo.com/*",
    "https://*.egcvi.com/*",
    "https://*.mstrom-uno.com/*",
    "https://*.673ing.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.dafabet.net/*",
        "https://*.dafabet.com/*",
        "https://*.df888evo.com/*",
        "https://*.egcvi.com/*",
        "https://*.mstrom-uno.com/*",
        "https://*.673ing.com/*"
      ],
      "js": [
        "network-hook.js",
        "runtime-state-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.dafabet.net/*",
        "https://*.dafabet.com/*",
        "https://*.df888evo.com/*",
        "https://*.egcvi.com/*",
        "https://*.mstrom-uno.com/*",
        "https://*.673ing.com/*"
      ],
      "js": [
        "dom-probe.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.dafabet.net/*",
        "https://*.dafabet.com/*",
        "https://*.df888evo.com/*",
        "https://*.egcvi.com/*",
        "https://*.mstrom-uno.com/*",
        "https://*.673ing.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Baccarat Room Bridge"
  }
}
